#!/usr/bin/env bash
#BSUB -J v2fam_shrunk
#BSUB -q hpc
#BSUB -n 8
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=6GB]"
#BSUB -M 7GB
#BSUB -W 2:00
#BSUB -o /dtu-compute/sciofsci/magnificat/lsf/v2fam/shrunk.%J.out
#BSUB -e /dtu-compute/sciofsci/magnificat/lsf/v2fam/shrunk.%J.out
set -uo pipefail
cd /dtu-compute/sciofsci/magnificat
export PYTHONPATH=src
P=artifacts/rtgpu312/bin/python
echo "host=$(hostname) start=$(date -Is)"
OMP_NUM_THREADS=4 $P scripts/build_v2_families.py --tag 122bC --jobs 8 \
  --tutor artifacts/v2t_turn_probs_v2ext_122bC.pkl.gz \
  --student artifacts/v2s_turn_probs_v2stu_122bC.pkl.gz || exit 1
echo ""
echo "=== does shrinkage actually flatten the noise, on real sessions? ==="
$P - <<'PY'
import sys, pandas as pd, numpy as np
sys.path.insert(0, "src")
r = pd.read_csv("artifacts/v2fam_rate_122bC.csv").set_index("session_id")
h = pd.read_csv("artifacts/v2fam_shrunk_122bC.csv").set_index("session_id")
tp = pd.read_pickle("artifacts/v2t_turn_probs_v2ext_122bC.pkl.gz", compression="gzip")
n = tp.groupby("session_id").n_turns.first().reindex(r.index)
# The claim is NOT that the columns change much in TtA -- it is that their spread stops
# depending on session length. Between-session sd within a length band is the observable.
print(f"{'band':12s} {'n_sess':>7s} | {'plain sd':>9s} {'shrunk sd':>10s}   (v2t_asking_question_rate)")
bands = [(0,20),(20,50),(50,90),(90,130),(130,10000)]
ps, hs = [], []
for lo,hi in bands:
    m = (n>=lo)&(n<hi)
    if m.sum() < 30: continue
    a = r.loc[m.values,"v2t_asking_question_rate"].std()
    b = h.loc[m.values,"v2ht_asking_question_rate"].std()
    ps.append(a); hs.append(b)
    print(f"{lo:4d}-{hi if hi<9999 else 999:<7d} {m.sum():7d} | {a:9.4f} {b:10.4f}")
print(f"\nspread across bands (max/min):  plain {max(ps)/min(ps):.2f}x   shrunk {max(hs)/min(hs):.2f}x")
print("A GBM threshold is a single number; the closer that ratio is to 1, the more nearly the")
print("same threshold means the same thing on a 10-turn and a 150-turn transcript.")
PY
echo "SHRUNKBUILD-DONE rc=$? $(date -Is)"
