#!/bin/bash
### Step 06c, fold parent 3. Identical to traceace_qwen3_8b_full_fold1 except --fold/-J. The pkl
### is the --select full build (no last-40-turn window) and LLMKT_MAX_SEQ_LEN=8192. Qwen3-8B,
### bf16, same 5-fold LO-disjoint split, 2 epochs, on p1 (H100 80GB).
#BSUB -J qwen3_full_f3
#BSUB -q p1
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=32GB]"
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -W 48:00
#BSUB -o /dtu-compute/sciofsci/magnificat/external/dialogue-kt/lsf/logs/%J_qwen3_full_f3.out
#BSUB -e /dtu-compute/sciofsci/magnificat/external/dialogue-kt/lsf/logs/%J_qwen3_full_f3.err

cd /dtu-compute/sciofsci/magnificat/external/dialogue-kt
export TRACEACE_PKL=data/annotated/traceace_full.pkl    # arm A1 build (--select full)
export LLMKT_MAX_SEQ_LEN=8192                            # keep the whole transcript (H100)
./run_kt_lsf.sh train --dataset traceace --model_type lmkt --fold 3 \
    --pack_kcs 0 --quantize 0 --inc_first_label \
    --epochs 2 \
    --base_model Qwen/Qwen3-8B \
    --model_name lmkt_traceace_qwen3_8b_full
