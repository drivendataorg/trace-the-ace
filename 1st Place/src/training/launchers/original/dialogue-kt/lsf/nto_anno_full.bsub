#!/bin/bash
### Step 02b: NTO tutor-move annotation (Qwen3-32B), shard $SHARD of 3.
### ~22.8k sessions / 3 shards; guided JSON; resume-safe (skips sessions already in own csv).
### shard0's csv also holds 10 sessions from a test run under 0/1 sharding, so merging the
### shards must dedupe on (session_id, turn).
#BSUB -J nto_full_s${SHARD}
#BSUB -q p1
#BSUB -n 8
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=64GB]"
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -W 24:00
#BSUB -o /dtu-compute/sciofsci/magnificat/external/dialogue-kt/lsf/logs/%J_nto_full_s${SHARD}.out
#BSUB -e /dtu-compute/sciofsci/magnificat/external/dialogue-kt/lsf/logs/%J_nto_full_s${SHARD}.err

cd /dtu-compute/sciofsci/magnificat/external/dialogue-kt
unset LD_LIBRARY_PATH
export HF_HOME=/dtu-compute/sciofsci/magnificat/external/dialogue-kt/.hf
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export VLLM_USE_FLASHINFER_SAMPLER=0
export FLASHINFER_WORKSPACE_DIR=/dtu-compute/sciofsci/magnificat/.flashinfer
export XDG_CACHE_HOME=/dtu-compute/sciofsci/magnificat/.cache
export ANNO_SHARD="${SHARD}/3"
echo "[nto_full] host=$(hostname) shard=${SHARD}/3"
exec .env-vllm/bin/python annotate_nto_moves.py
